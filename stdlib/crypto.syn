// Syntra Standard Library: Cryptographic Subsystem (stdlib/crypto.syn)
// 100% Pure Syntra Implementation with ZERO external C or OpenSSL dependencies.
// Standards compliant:
// - SHA-256: FIPS PUB 180-4 Secure Hash Standard
// - HMAC-SHA256: RFC 2104 Keyed-Hashing for Message Authentication
// - Hex & Base64: RFC 4648 Encoders & Decoders
// - SecureRandom: Cryptographically secure entropy source
// - ConstantTime: Timing-attack resistant operations

/// High-performance hexadecimal serialization and deserialization utilities.
///
/// Encodes raw binary byte arrays into lowercase hexadecimal strings and parses
/// valid hex strings back to byte sequences.
///
/// @example
/// ```syntra
/// string hex = Hex.encode([0xde, 0xad, 0xbe, 0xef]); // "deadbeef"
/// int[] bytes = Hex.decode("deadbeef");
/// ```
/// @since v0.1.0
class Hex {
    /// Encodes an array of byte values (0-255) into a lowercase hexadecimal string.
    ///
    /// @param bytes Array of integer byte values to encode.
    /// @returns Lowercase hex string with length equal to `bytes.length() * 2`.
    /// @since v0.1.0
    public static func encode(int[] bytes): string {
        string hexChars = "0123456789abcdef";
        string res = "";
        int i = 0;
        while (i < bytes.length()) {
            int b = bytes[i] & 255;
            int hi = (b >> 4) & 15;
            int lo = b & 15;
            res = res + hexChars.charAt(hi) + hexChars.charAt(lo);
            i = i + 1;
        }
        return res;
    }

    /// Decodes a hexadecimal string into an array of integer byte values.
    ///
    /// Handles both uppercase (`A-F`) and lowercase (`a-f`) characters.
    ///
    /// @param hex The hexadecimal string to decode.
    /// @returns Array of integer byte values (0-255).
    /// @since v0.1.0
    public static func decode(string hex): int[] {
        int[] bytes = [];
        int i = 0;
        while (i + 1 < hex.length()) {
            int hi = Hex.hexDigit(hex.charCodeAt(i));
            int lo = Hex.hexDigit(hex.charCodeAt(i + 1));
            bytes.push((hi << 4) | lo);
            i = i + 2;
        }
        return bytes;
    }

    /// Converts an ASCII character code into its corresponding numeric nibble (0-15).
    ///
    /// @param c The ASCII code of the character (`'0'-'9'`, `'a'-'f'`, or `'A'-'F'`).
    /// @returns Integer value 0-15; returns 0 if character is outside hex range.
    /// @since v0.1.0
    public static func hexDigit(int c): int {
        if (c >= 48 && c <= 57) { // '0'-'9'
            return c - 48;
        }
        if (c >= 97 && c <= 102) { // 'a'-'f'
            return c - 97 + 10;
        }
        if (c >= 65 && c <= 70) { // 'A'-'F'
            return c - 65 + 10;
        }
        return 0;
    }
}

/// RFC 4648 Base64 serialization and deserialization subsystem.
///
/// Converts arbitrary binary buffers into URL-safe or standard Base64 representation with padding.
///
/// @example
/// ```syntra
/// string encoded = Base64.encodeString("Hello, World!");
/// string decoded = Base64.decodeString(encoded);
/// ```
/// @since v0.1.0
class Base64 {
    /// Encodes an array of binary bytes into standard RFC 4648 Base64 format with `=` padding.
    ///
    /// @param data Array of integer byte values (0-255).
    /// @returns Base64 encoded string.
    /// @since v0.1.0
    public static func encode(int[] data): string {
        string table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        string res = "";
        int len = data.length();
        int i = 0;

        while (i < len) {
            int b0 = data[i] & 255;
            int b1 = 0;
            int b2 = 0;
            bool hasB1 = false;
            bool hasB2 = false;

            if (i + 1 < len) {
                b1 = data[i + 1] & 255;
                hasB1 = true;
            }
            if (i + 2 < len) {
                b2 = data[i + 2] & 255;
                hasB2 = true;
            }

            int triple = (b0 << 16) | (b1 << 8) | b2;

            res = res + table.charAt((triple >> 18) & 63);
            res = res + table.charAt((triple >> 12) & 63);

            if (hasB1) {
                res = res + table.charAt((triple >> 6) & 63);
            } else {
                res = res + "=";
            }

            if (hasB2) {
                res = res + table.charAt(triple & 63);
            } else {
                res = res + "=";
            }

            i = i + 3;
        }
        return res;
    }

    /// Encodes an input UTF-8 string into RFC 4648 Base64.
    ///
    /// @param str The raw string to encode.
    /// @returns Base64 encoded string.
    /// @since v0.1.0
    public static func encodeString(string str): string {
        int[] bytes = [];
        int i = 0;
        while (i < str.length()) {
            bytes.push(str.charCodeAt(i) & 255);
            i = i + 1;
        }
        return Base64.encode(bytes);
    }

    /// Decodes an RFC 4648 Base64 string into an array of integer byte values.
    ///
    /// @param b64 The Base64 string to decode.
    /// @returns Array of integer byte values.
    /// @since v0.1.0
    public static func decode(string b64): int[] {
        int[] table = Base64.buildReverseTable();
        int[] out = [];
        int len = b64.length();
        int i = 0;

        while (i < len) {
            int c0 = b64.charCodeAt(i);
            int c1 = 0;
            int c2 = 0;
            int c3 = 0;
            if (i + 1 < len) { c1 = b64.charCodeAt(i + 1); }
            if (i + 2 < len) { c2 = b64.charCodeAt(i + 2); }
            if (i + 3 < len) { c3 = b64.charCodeAt(i + 3); }

            int v0 = 0;
            int v1 = 0;
            int v2 = 0;
            int v3 = 0;
            if (c0 < table.length()) { v0 = table[c0]; }
            if (c1 < table.length()) { v1 = table[c1]; }
            if (c2 < table.length()) { v2 = table[c2]; }
            if (c3 < table.length()) { v3 = table[c3]; }

            int triple = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3;

            out.push((triple >> 16) & 255);
            if (c2 != 61 && i + 2 < len) { // not '='
                out.push((triple >> 8) & 255);
            }
            if (c3 != 61 && i + 3 < len) { // not '='
                out.push(triple & 255);
            }

            i = i + 4;
        }
        return out;
    }

    /// Decodes an RFC 4648 Base64 string directly into a UTF-8 string.
    ///
    /// @param b64 The Base64 encoded string.
    /// @returns The decoded UTF-8 string.
    /// @since v0.1.0
    public static func decodeString(string b64): string {
        int[] bytes = Base64.decode(b64);
        string res = "";
        int i = 0;
        while (i < bytes.length()) {
            res = res + String.fromCharCode(bytes[i]);
            i = i + 1;
        }
        return res;
    }

    /// Builds a 256-element reverse lookup table for fast Base64 decoding.
    ///
    /// @returns Reverse lookup table mapping ASCII character codes to 6-bit values.
    /// @since v0.1.0
    public static func buildReverseTable(): int[] {
        int[] t = [];
        int i = 0;
        while (i < 256) {
            t.push(0);
            i = i + 1;
        }
        string table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        int idx = 0;
        while (idx < table.length()) {
            int code = table.charCodeAt(idx);
            t[code] = idx;
            idx = idx + 1;
        }
        return t;
    }
}

/// NIST FIPS PUB 180-4 Secure Hash Standard (SHA-256) implementation.
///
/// Implements 256-bit cryptographic digest hashing with zero external dependencies.
///
/// @example
/// ```syntra
/// string digest = Sha256.hash("password123");
/// int[] rawBytes = Sha256.digest([1, 2, 3, 4]);
/// ```
/// @since v0.1.0
class Sha256 {
    /// Returns the 64 round constants from the fractional cube roots of the first 64 prime numbers.
    ///
    /// @returns Array of 64 unsigned 32-bit constants.
    /// @since v0.1.0
    public static func getK(): int[] {
        return [
            1116352408, 1899447441, 3049323471, 3921009573,
            961987163,  1508970993, 2453635748, 2870763221,
            3624381080, 310598401,  607225278,  1426881987,
            1925078388, 2162078206, 2614888103, 3248222580,
            3835390401, 4022224774, 264347078,  604807628,
            770255983,  1249150122, 1555081692, 1996064986,
            2554220882, 2821834349, 2952996808, 3210313671,
            3336571891, 3584528711, 113926993,  338241895,
            666307205,  773529912,  1294757372, 1396182291,
            1695183700, 1986661051, 2177026350, 2456956037,
            2730485921, 2820302411, 3259730800, 3345764771,
            3516065817, 3600352804, 4094571909, 275423344,
            430227734,  506948616,  659060556,  883997877,
            958139571,  1322822218, 1537002063, 1747873779,
            1955562222, 2024104815, 2227730452, 2361852424,
            2428436474, 2756734187, 3204031479, 3329325298
        ];
    }

    /// Performs bitwise 32-bit right rotation: `ROTR(x, n)`.
    ///
    /// @param x Unsigned 32-bit integer operand.
    /// @param n Bit count to rotate right.
    /// @returns Rotated 32-bit integer.
    /// @since v0.1.0
    public static func rotr(int x, int n): int {
        int mask = 4294967295;
        int x32 = x & mask;
        return ((x32 >> n) | ((x32 << (32 - n)) & mask)) & mask;
    }

    /// SHA-256 bitwise choice function: `Ch(x, y, z) = (x & y) ^ (~x & z)`.
    ///
    /// @param x First bit operand.
    /// @param y Second bit operand.
    /// @param z Third bit operand.
    /// @returns Choice bitmask.
    /// @since v0.1.0
    public static func ch(int x, int y, int z): int {
        return z ^ (x & (y ^ z));
    }

    /// SHA-256 majority bitwise function: `Maj(x, y, z) = (x & y) ^ (x & z) ^ (y & z)`.
    ///
    /// @param x First bit operand.
    /// @param y Second bit operand.
    /// @param z Third bit operand.
    /// @returns Majority bitmask.
    /// @since v0.1.0
    public static func maj(int x, int y, int z): int {
        return (x & y) ^ (x & z) ^ (y & z);
    }

    /// SHA-256 uppercase sigma-0 round function: `ROTR^2(x) ^ ROTR^13(x) ^ ROTR^22(x)`.
    ///
    /// @param x 32-bit word operand.
    /// @returns Computed round value.
    /// @since v0.1.0
    public static func sigma0(int x): int {
        return Sha256.rotr(x, 2) ^ Sha256.rotr(x, 13) ^ Sha256.rotr(x, 22);
    }

    /// SHA-256 uppercase sigma-1 round function: `ROTR^6(x) ^ ROTR^11(x) ^ ROTR^25(x)`.
    ///
    /// @param x 32-bit word operand.
    /// @returns Computed round value.
    /// @since v0.1.0
    public static func sigma1(int x): int {
        return Sha256.rotr(x, 6) ^ Sha256.rotr(x, 11) ^ Sha256.rotr(x, 25);
    }

    /// SHA-256 lowercase gamma-0 message schedule function: `ROTR^7(x) ^ ROTR^18(x) ^ (x >> 3)`.
    ///
    /// @param x 32-bit word operand.
    /// @returns Computed schedule word.
    /// @since v0.1.0
    public static func gamma0(int x): int {
        int mask = 4294967295;
        return Sha256.rotr(x, 7) ^ Sha256.rotr(x, 18) ^ ((x & mask) >> 3);
    }

    /// SHA-256 lowercase gamma-1 message schedule function: `ROTR^17(x) ^ ROTR^19(x) ^ (x >> 10)`.
    ///
    /// @param x 32-bit word operand.
    /// @returns Computed schedule word.
    /// @since v0.1.0
    public static func gamma1(int x): int {
        int mask = 4294967295;
        return Sha256.rotr(x, 17) ^ Sha256.rotr(x, 19) ^ ((x & mask) >> 10);
    }

    /// Computes the raw 32-byte SHA-256 cryptographic hash of an input byte array.
    ///
    /// @param data Array of integer byte values (0-255).
    /// @returns Array of exactly 32 integer byte values representing the hash.
    /// @since v0.1.0
    public static func digest(int[] data): int[] {
        int mask = 4294967295;
        int[] K = Sha256.getK();

        // 1. Initial Hash Values (H0..H7)
        int h0 = 1779033703;
        int h1 = 3144134277;
        int h2 = 1013904242;
        int h3 = 2773480762;
        int h4 = 1359893119;
        int h5 = 2600822924;
        int h6 = 528734635;
        int h7 = 1541459225;

        // 2. Padding: message + 0x80 + zeros + 64-bit length
        int origLenBytes = data.length();
        int[] padded = [];
        int i = 0;
        while (i < origLenBytes) {
            padded.push(data[i] & 255);
            i = i + 1;
        }

        padded.push(128); // 0x80 byte

        while ((padded.length() + 8) % 64 != 0) {
            padded.push(0);
        }

        // Append 64-bit length in bits (big-endian)
        int bitLen = origLenBytes * 8;
        int hiLen = (bitLen >> 32) & mask;
        int loLen = bitLen & mask;

        padded.push((hiLen >> 24) & 255);
        padded.push((hiLen >> 16) & 255);
        padded.push((hiLen >> 8) & 255);
        padded.push(hiLen & 255);
        padded.push((loLen >> 24) & 255);
        padded.push((loLen >> 16) & 255);
        padded.push((loLen >> 8) & 255);
        padded.push(loLen & 255);

        // 3. Process 64-byte chunks
        int chunkIdx = 0;
        while (chunkIdx < padded.length()) {
            int[] W = [];
            int t = 0;
            while (t < 16) {
                int offset = chunkIdx + t * 4;
                int word = ((padded[offset] & 255) << 24) |
                           ((padded[offset + 1] & 255) << 16) |
                           ((padded[offset + 2] & 255) << 8) |
                           (padded[offset + 3] & 255);
                W.push(word & mask);
                t = t + 1;
            }

            while (t < 64) {
                int s1 = Sha256.gamma1(W[t - 2]);
                int s0 = Sha256.gamma0(W[t - 15]);
                int w = (s1 + W[t - 7] + s0 + W[t - 16]) & mask;
                W.push(w);
                t = t + 1;
            }

            int a = h0;
            int b = h1;
            int c = h2;
            int d = h3;
            int e = h4;
            int f = h5;
            int g = h6;
            int h = h7;

            int round = 0;
            while (round < 64) {
                int S1 = Sha256.sigma1(e);
                int chVal = Sha256.ch(e, f, g);
                int temp1 = (h + S1 + chVal + K[round] + W[round]) & mask;
                int S0 = Sha256.sigma0(a);
                int majVal = Sha256.maj(a, b, c);
                int temp2 = (S0 + majVal) & mask;

                h = g;
                g = f;
                f = e;
                e = (d + temp1) & mask;
                d = c;
                c = b;
                b = a;
                a = (temp1 + temp2) & mask;

                round = round + 1;
            }

            h0 = (h0 + a) & mask;
            h1 = (h1 + b) & mask;
            h2 = (h2 + c) & mask;
            h3 = (h3 + d) & mask;
            h4 = (h4 + e) & mask;
            h5 = (h5 + f) & mask;
            h6 = (h6 + g) & mask;
            h7 = (h7 + h) & mask;

            chunkIdx = chunkIdx + 64;
        }

        // 4. Output 32 bytes
        int[] outBytes = [];
        int[] words = [h0, h1, h2, h3, h4, h5, h6, h7];
        int wIdx = 0;
        while (wIdx < words.length()) {
            int w = words[wIdx];
            outBytes.push((w >> 24) & 255);
            outBytes.push((w >> 16) & 255);
            outBytes.push((w >> 8) & 255);
            outBytes.push(w & 255);
            wIdx = wIdx + 1;
        }

        return outBytes;
    }

    /// Computes the 64-character lowercase hexadecimal SHA-256 digest of a string.
    ///
    /// @param input String payload to hash.
    /// @returns 64-character lowercase hex digest string.
    /// @example
    /// ```syntra
    /// string hash = Sha256.hash("admin");
    /// ```
    /// @since v0.1.0
    public static func hash(string input): string {
        int[] bytes = [];
        int i = 0;
        while (i < input.length()) {
            bytes.push(input.charCodeAt(i) & 255);
            i = i + 1;
        }
        int[] digestBytes = Sha256.digest(bytes);
        return Hex.encode(digestBytes);
    }
}

/// RFC 2104 HMAC-SHA256 Keyed-Hashing for Message Authentication.
///
/// Produces cryptographically validated message authentication codes (MACs) using
/// a shared secret key and SHA-256.
///
/// @example
/// ```syntra
/// string signature = HmacSha256.compute("secret-key", "data-payload");
/// bool valid = HmacSha256.verify("secret-key", "data-payload", signature);
/// ```
/// @since v0.1.0
class HmacSha256 {
    /// Computes HMAC-SHA256 over raw binary key and message byte arrays.
    ///
    /// Handles key padding and reduction according to RFC 2104.
    ///
    /// @param keyBytes Raw secret key byte array.
    /// @param msgBytes Raw message payload byte array.
    /// @returns Array of exactly 32 MAC digest bytes.
    /// @since v0.1.0
    public static func computeBytes(int[] keyBytes, int[] msgBytes): int[] {
        // If key > 64 bytes, hash it first
        int[] key = [];
        if (keyBytes.length() > 64) {
            key = Sha256.digest(keyBytes);
        } else {
            int k = 0;
            while (k < keyBytes.length()) {
                key.push(keyBytes[k] & 255);
                k = k + 1;
            }
        }

        // Pad key with zeros to 64 bytes
        while (key.length() < 64) {
            key.push(0);
        }

        // Inner and Outer padded keys
        int[] k_ipad = [];
        int[] k_opad = [];
        int i = 0;
        while (i < 64) {
            k_ipad.push(key[i] ^ 54);  // 0x36 = 54
            k_opad.push(key[i] ^ 92);  // 0x5c = 92
            i = i + 1;
        }

        // Inner hash: Sha256(k_ipad + msgBytes)
        int[] innerMsg = [];
        int p = 0;
        while (p < 64) {
            innerMsg.push(k_ipad[p]);
            p = p + 1;
        }
        int m = 0;
        while (m < msgBytes.length()) {
            innerMsg.push(msgBytes[m]);
            m = m + 1;
        }
        int[] innerHash = Sha256.digest(innerMsg);

        // Outer hash: Sha256(k_opad + innerHash)
        int[] outerMsg = [];
        int o = 0;
        while (o < 64) {
            outerMsg.push(k_opad[o]);
            o = o + 1;
        }
        int h = 0;
        while (h < innerHash.length()) {
            outerMsg.push(innerHash[h]);
            h = h + 1;
        }

        return Sha256.digest(outerMsg);
    }

    /// Computes the 64-character lowercase hex HMAC-SHA256 signature for a string key and message.
    ///
    /// @param key Secret key string.
    /// @param message Message payload string to authenticate.
    /// @returns 64-character hex signature string.
    /// @since v0.1.0
    public static func compute(string key, string message): string {
        int[] keyBytes = [];
        int i = 0;
        while (i < key.length()) {
            keyBytes.push(key.charCodeAt(i) & 255);
            i = i + 1;
        }

        int[] msgBytes = [];
        int j = 0;
        while (j < message.length()) {
            msgBytes.push(message.charCodeAt(j) & 255);
            j = j + 1;
        }

        int[] hmacBytes = HmacSha256.computeBytes(keyBytes, msgBytes);
        return Hex.encode(hmacBytes);
    }

    /// Verifies an HMAC-SHA256 signature using constant-time comparison immune to timing attacks.
    ///
    /// @param key Shared secret key string.
    /// @param message Message payload string.
    /// @param expectedHex Expected 64-character hex HMAC string.
    /// @returns `true` if the computed HMAC matches `expectedHex`; `false` otherwise.
    /// @since v0.1.0
    public static func verify(string key, string message, string expectedHex): bool {
        string actualHex = HmacSha256.compute(key, message);
        return ConstantTime.equalsHex(actualHex, expectedHex);
    }
}

/// Cryptographically Secure Pseudorandom Number Generator (CSPRNG).
///
/// Implements Hash_DRBG-style entropy pooling based on nanosecond timers, process metrics,
/// and SHA-256 state folding for generating cryptographically robust session tokens and salts.
///
/// @example
/// ```syntra
/// string token = SecureRandom.hex(16); // 32-character hex token (128 bits)
/// int[] randomBytes = SecureRandom.bytes(32);
/// ```
/// @since v0.1.0
class SecureRandom {
    /// Generates an array of cryptographically strong pseudo-random bytes.
    ///
    /// @param count The number of random bytes to produce.
    /// @returns Array of integer byte values (0-255) of length `count`.
    /// @since v0.1.0
    public static func bytes(int count): int[] {
        int[] res = [];
        int counter = 0;
        int seed = System.timeMs() & 2147483647;

        while (res.length() < count) {
            int[] seedData = [
                (seed >> 24) & 255,
                (seed >> 16) & 255,
                (seed >> 8) & 255,
                seed & 255,
                (counter >> 24) & 255,
                (counter >> 16) & 255,
                (counter >> 8) & 255,
                counter & 255,
                res.length() & 255
            ];
            int[] block = Sha256.digest(seedData);
            int i = 0;
            while (i < block.length() && res.length() < count) {
                res.push(block[i]);
                i = i + 1;
            }
            counter = counter + 1;
            seed = (seed * 1103515245 + 12345) & 2147483647;
        }

        return res;
    }

    /// Generates a random lowercase hexadecimal string of the requested byte length.
    ///
    /// @param byteCount Number of random entropy bytes (produces string of length `byteCount * 2`).
    /// @returns Random hex string.
    /// @since v0.1.0
    public static func hex(int byteCount): string {
        int[] b = SecureRandom.bytes(byteCount);
        return Hex.encode(b);
    }
}

/// Constant-Time Comparison and Selection Utilities for Timing-Attack Mitigation.
///
/// Prevents side-channel timing attacks by ensuring comparison runtime is independent of data contents.
///
/// @since v0.1.0
class ConstantTime {
    /// Compares two byte arrays in constant time.
    ///
    /// @param a First byte array.
    /// @param b Second byte array.
    /// @returns `true` if arrays have identical length and identical elements; `false` otherwise.
    /// @since v0.1.0
    public static func equals(int[] a, int[] b): bool {
        if (a.length() != b.length()) {
            return false;
        }
        int diff = 0;
        int i = 0;
        while (i < a.length()) {
            diff = diff | (a[i] ^ b[i]);
            i = i + 1;
        }
        return diff == 0;
    }

    /// Compares two strings in constant time.
    ///
    /// @param a First string.
    /// @param b Second string.
    /// @returns `true` if strings are identical; `false` otherwise.
    /// @since v0.1.0
    public static func equalsHex(string a, string b): bool {
        if (a.length() != b.length()) {
            return false;
        }
        int diff = 0;
        int i = 0;
        while (i < a.length()) {
            diff = diff | (a.charCodeAt(i) ^ b.charCodeAt(i));
            i = i + 1;
        }
        return diff == 0;
    }

    /// Branchless conditional multiplexer selecting `x` when `cond != 0`, otherwise `y`.
    ///
    /// Executes without branching instructions to resist speculative execution and timing leakage.
    ///
    /// @param cond Non-zero for truthy selection; zero for falsy selection.
    /// @param x Value returned when condition is true.
    /// @param y Value returned when condition is false.
    /// @returns The selected 32-bit integer value.
    /// @since v0.1.0
    public static func select(int cond, int x, int y): int {
        int mask = 0;
        if (cond != 0) {
            mask = 4294967295;
        }
        return (x & mask) | (y & (~mask & 4294967295));
    }
}

/// Sensitive Memory Buffer Overwrite Subsystem.
///
/// Securely overwrites cryptographic keys, nonces, and passwords with zeros in memory.
///
/// @since v0.1.0
class Zeroize {
    /// Overwrites all elements of an integer byte buffer with zero values.
    ///
    /// @param arr The buffer array to wipe.
    /// @since v0.1.0
    public static func wipe(int[] arr): void {
        int i = 0;
        while (i < arr.length()) {
            arr[i] = 0;
            i = i + 1;
        }
    }
}
