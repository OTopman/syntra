// Syntra Self-Hosting Compiler Milestone 4 Test
// Demonstrates Complete Self-Hosting Compiler Pipeline:
// Source Code -> Lexer -> Parser -> TypeChecker -> AIR SSA -> Native Assembly Generator (x86-64)
// Output assembly is written to disk and executed natively.

import "../stdlib/syntax.syn";
import "../stdlib/checker.syn";
import "../stdlib/air.syn";
import "../stdlib/codegen.syn";

func main(): int {
    println("=== Syntra Self-Hosting Compiler: Milestone 4 Verification ===");

    Arena compArena = Arena.create(131072);
    println("Compiler Arena initialized: 131072 bytes");

    // A complete standalone program to compile into native assembly
    string sampleCode = "func add(int a, int b): int {\n    return a + b;\n}\nfunc main(): int {\n    int x = 20;\n    int y = 22;\n    return add(x, y);\n}";

    // -------------------------------------------------------------
    // Step 1: Lexical Analysis
    // -------------------------------------------------------------
    println("\n--- Step 1: Lexical Analysis ---");
    Lexer lexer = new Lexer(sampleCode);
    Token[] tokens = lexer.tokenize();
    println("Tokenization complete: " + tokens.length() + " tokens.");

    // -------------------------------------------------------------
    // Step 2: Syntactic Analysis (Arena AST)
    // -------------------------------------------------------------
    println("\n--- Step 2: Syntactic Analysis ---");
    Parser parser = new Parser(tokens, compArena);
    AstNode programAst = parser.parseProgram();
    println("Parsing complete: " + programAst.childCount() + " functions.");

    // -------------------------------------------------------------
    // Step 3: Semantic Analysis & Symbol Resolution
    // -------------------------------------------------------------
    println("\n--- Step 3: Semantic Analysis ---");
    TypeChecker checker = new TypeChecker();
    checker.checkProgram(programAst);
    println("Type checking complete: " + checker.errorCount() + " errors.");
    if (checker.hasErrors()) {
        println("FAILED: Semantic errors found");
        return 1;
    }

    // -------------------------------------------------------------
    // Step 4: AIR SSA Lowering
    // -------------------------------------------------------------
    println("\n--- Step 4: AIR SSA Lowering ---");
    AirLowering lowering = new AirLowering(checker, "self_hosted_module");
    AirModule airMod = lowering.lowerProgram(programAst);
    println("AIR Lowering complete: " + airMod.functions.length() + " functions.");

    // -------------------------------------------------------------
    // Step 5: Native Machine Assembly Generation (x86-64)
    // -------------------------------------------------------------
    println("\n--- Step 5: Native Code Generation ---");
    NativeCodegen codegen = new NativeCodegen(airMod);
    string asmSource = codegen.generateModule();

    println("Assembly code generated successfully!");
    println("---------------- Generated x86-64 Assembly ----------------");
    println(asmSource);
    println("-----------------------------------------------------------");

    if (asmSource.contains(".intel_syntax noprefix") == false) {
        println("FAILED: Missing intel syntax directive");
        return 1;
    }
    if (asmSource.contains(".globl _add") == false || asmSource.contains(".globl _main") == false) {
        println("FAILED: Missing global symbol exports");
        return 1;
    }
    if (asmSource.contains("push rbp") == false || asmSource.contains("ret") == false) {
        println("FAILED: Missing stack frame instructions");
        return 1;
    }

    // -------------------------------------------------------------
    // Step 6: Write Assembly File to Disk
    // -------------------------------------------------------------
    println("\n--- Step 6: Writing Output Assembly File ---");
    File asmFile = new File("/tmp/self_hosted_gen.s");
    asmFile.writeText(asmSource);
    println("Assembly written to: " + asmFile.getPath() + " (" + asmFile.size() + " bytes)");

    // -------------------------------------------------------------
    // Step 7: Arena Bulk Reclamation
    // -------------------------------------------------------------
    println("\n--- Step 7: Arena Memory Domain Recycling ---");
    println("Bytes allocated in Arena during compilation: " + compArena.allocatedBytes());
    compArena.reset();
    println("Bytes allocated after reset: " + compArena.allocatedBytes());
    if (compArena.allocatedBytes() != 0) {
        println("FAILED: Arena bytes should be 0");
        return 1;
    }

    println("\n=======================================================");
    println("SELF-HOSTING CODE GENERATION VERIFIED (100%)");
    println("=======================================================");
    return 0;
}
