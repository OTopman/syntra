/// @fileoverview Syntra Multi-Task Concurrency & Channel Primitives.
///
/// Demonstrates:
/// - Asynchronous Task spawning with function pointers (`Task.spawn(backgroundWorker, 5)`)
/// - Anonymous lambda task workers (`Task.spawn(() => { ... })`)
/// - Task joining and result retrieval (`t1.join()`)
/// - Cross-task typed message passing using CSP channels (`Channel`)
/// - Channel capacity, length inspection, and graceful stream closure
///
/// @example
/// ```bash
/// syn run examples/concurrency_test.syn
/// ```
/// @since v0.1.0

fn backgroundWorker(int x): int {
    Task.sleep(20);
    return x * 10;
}

fn producer(Channel ch): int {
    for (int i = 1; i <= 3; i = i + 1) {
        ch.send(i * 100);
    }
    ch.close();
    return 1;
}

fn main(): void {
    println("--- Testing Task Spawning & Joining ---");
    Task t1 = Task.spawn(backgroundWorker, 5);
    int res1 = t1.join();
    println("Task 1 result: " + res1);

    Task t2 = Task.spawn(() => {
        Task.sleep(10);
        return 999;
    });
    int res2 = t2.join();
    println("Task 2 (lambda) result: " + res2);

    println("--- Testing Channel Communication ---");
    Channel ch = new Channel();
    println("Channel initial empty: " + ch.isEmpty());
    println("Channel initial len: " + ch.len());

    ch.send(42);
    ch.send(84);
    println("Channel len after 2 sends: " + ch.len());
    println("Channel isEmpty: " + ch.isEmpty());

    int val1 = ch.recv();
    int val2 = ch.recv();
    println("Received val1: " + val1);
    println("Received val2: " + val2);
    println("Channel len after recvs: " + ch.len());

    println("--- Testing Threaded Producer Channel ---");
    Channel ch2 = new Channel();
    Task prodTask = Task.spawn(producer, ch2);

    int r1 = ch2.recv();
    int r2 = ch2.recv();
    int r3 = ch2.recv();
    println("Producer received 1: " + r1);
    println("Producer received 2: " + r2);
    println("Producer received 3: " + r3);

    prodTask.join();
    println("Producer task joined successfully!");
    println("Concurrency verification complete!");
}
