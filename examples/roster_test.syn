class Hero {
    public string name;
    public int level;

    new(string name, int level) {
        this.name = name;
        this.level = level;
    }

    public func describe(): void {
        println("Hero " + this.name + " (Level " + this.level + ")");
    }
}

func main(): int {
    string[] titles = ["Warrior", "Mage", "Ranger"];
    println("Available titles: " + titles.length);
    for t in titles {
        println(" - " + t);
    }

    Hero[] party = [
        new Hero("Aria", 12),
        new Hero("Theron", 15),
        new Hero("Lyra", 18)
    ];

    println("\nParty Roster (" + party.length + " members):");
    int total_level = 0;
    for (int i = 0; i < party.length; i = i + 1) {
        party[i].describe();
        total_level = total_level + party[i].level;
    }

    println("Total Party Level: " + total_level);
    return total_level;
}
