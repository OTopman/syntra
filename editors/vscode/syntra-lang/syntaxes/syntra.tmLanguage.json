{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Syntra",
  "scopeName": "source.syn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.syntra",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.syntra",
          "match": "//.*$"
        },
        {
          "name": "comment.block.syntra",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.syntra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.syntra",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.interpolation.syntra",
              "begin": "\\\\{",
              "end": "}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.syntra" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.syntra" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.syntra",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.syntra",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.numeric.hex.syntra",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.syntra",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.syntra",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.syntra",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.syntra",
          "match": "\\b(if|else|while|for|in|return|try|catch|finally|throw|select|case|default)\\b"
        },
        {
          "name": "keyword.declaration.function.syntra",
          "match": "\\b(func|fn)\\b"
        },
        {
          "name": "keyword.declaration.type.syntra",
          "match": "\\b(class|interface|namespace|package)\\b"
        },
        {
          "name": "keyword.other.syntra",
          "match": "\\b(import|new|this|super|public|private|static|override|const|let|mut|async|await|implements|extends)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.syntra",
          "match": "\\b(int|float|bool|string|void)\\b"
        },
        {
          "name": "entity.name.type.class.builtin.syntra",
          "match": "\\b(Array|Map|Task|Channel|ThreadPool|File|Math|System|Json|Dependency)\\b"
        },
        {
          "name": "entity.name.type.class.syntra",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(func|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.syntra" },
            "2": { "name": "entity.name.function.syntra" }
          }
        },
        {
          "name": "entity.name.function.call.syntra",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.syntra",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.comparison.syntra",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.syntra",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.syntra",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.syntra",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}